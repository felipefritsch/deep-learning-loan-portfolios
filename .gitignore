# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE/editor settings
.vscode/
.idea/
.claude/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST

# Logs and local runtime files
*.log
*.pid

# Local configuration/secrets
.env
.env.*
*.local

# Raw/local datasets
data/

# Disposable internal-disk artifacts (DuckDB catalog, sort spill, cached samples)
reports/

# LaTeX intermediate/build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc

# Built PDF (regenerate with latexmk; not tracked, to avoid binary churn in history)
writeup/latex/main.pdf
# Figure preview PNGs (generators emit .png next to the tracked .pdf; figs is PDF-only)
writeup/latex/figs/*.png


# Local SSD backup mirror (small irreplaceable artifacts; not for git)
ssd_mirror/

# Miscellaneous
misc/

# External reference material (copyrighted textbooks/papers; keep local only — never in git)
docs/bib_refs/

# Scratch/temp files
*.tmp

# Throwaway run drivers / sidecars (the kept, reproducible versions live in scripts/m27a/).
scratch_*

# Claude-created scratch notes (plans, audits, changelogs, state) — local only.
# Files moved here from the repo root/writeup on 2026-06-16; they remain in git
# history but are untracked going forward. Binding specs (specs/) and the
# writeup/memos deliverables are intentionally NOT ignored.
notes/

